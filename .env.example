# Copy this file to ".env" and fill in your own values.
# The real ".env" is gitignored and must never be committed.

# --- OpenAI ---
OPENAI_API_KEY=your-openai-key-here

# --- Storage backend ---
# Which storage to use: "local" or "blob"
STORAGE_MODE=local

# Local mode: folder where documents are stored
DOCUMENTS_PATH=documents

# Blob mode: Azure Blob Storage / Azurite emulator
# For the Azurite local emulator you can use: UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents
